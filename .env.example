# ==============================================================================
# MyDailyNews Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#
# Any setting specified here overrides config.local.json and config.recommended.json.

# ------------------------------------------------------------------------------
# 1. OPTION A: Host-running llama-server or LM Studio (Default)
# ------------------------------------------------------------------------------
# Point to your host's local llama-server (default is host.docker.internal:8080)
MYDAILYNEWS_AI_BASE_URL=http://host.docker.internal:8080/v1
MYDAILYNEWS_AI_BACKEND=llama_cpp_server
MYDAILYNEWS_AI_MANAGE_SERVER=false

# ------------------------------------------------------------------------------
# 2. OPTION B: Cloud / Hosted OpenAI-Compatible API (Zero-GPU turnkey mode)
# ------------------------------------------------------------------------------
# Examples:
#
# --- OpenAI:
# MYDAILYNEWS_AI_BASE_URL=https://api.openai.com/v1
# MYDAILYNEWS_AI_BACKEND=openai_compatible
# MYDAILYNEWS_AI_API_KEY=sk-...
# MYDAILYNEWS_AI_MODEL=gpt-4o-mini
#
# --- OpenRouter:
# MYDAILYNEWS_AI_BASE_URL=https://openrouter.ai/api/v1
# MYDAILYNEWS_AI_BACKEND=openai_compatible
# MYDAILYNEWS_AI_API_KEY=sk-or-v1-...
# MYDAILYNEWS_AI_MODEL=qwen/qwen-2.5-72b-instruct
#
# --- Groq:
# MYDAILYNEWS_AI_BASE_URL=https://api.groq.com/openai/v1
# MYDAILYNEWS_AI_BACKEND=openai_compatible
# MYDAILYNEWS_AI_API_KEY=gsk_...
# MYDAILYNEWS_AI_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. OPTION C: Bundled Ollama container (run with: docker compose --profile local-llm up)
# ------------------------------------------------------------------------------
# MYDAILYNEWS_AI_BASE_URL=http://ollama:11434/v1
# MYDAILYNEWS_AI_BACKEND=openai_compatible
# MYDAILYNEWS_AI_MODEL=qwen2.5:7b

# ------------------------------------------------------------------------------
# Optional Services
# ------------------------------------------------------------------------------
# GNews API key for international coverage retrieval in Perspectives Report
# MYDAILYNEWS_GNEWS_API_KEY=
